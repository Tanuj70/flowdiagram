# Copy to .env for docker compose. Generate SECRET_KEY with: python3 -c "import secrets;print(secrets.token_urlsafe(48))"
POSTGRES_PASSWORD=change-me
SECRET_KEY=
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=
# Set COOKIE_SECURE=false ONLY when testing over plain http://localhost
COOKIE_SECURE=true
PUBLIC_URL=https://studio.yourcompany.com
